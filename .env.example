# Konfigurasi Database MySQL (Gunakan akun khusus non-root dengan least privilege)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_tracker
DB_USER=pt_app
DB_PASS=GANTI_DENGAN_PASSWORD_DB_KUAT

# Secret Kriptografi Sesi & CSRF (Minimal 32 karakter acak)
PT_SESSION_SECRET=GANTI_DENGAN_64_HEX_KARAKTER_ACAK
PT_SESSION_COOKIE=pt_session

# Kebijakan Keamanan Sesi & Autentikasi
PT_SESSION_HOURS=12
PT_PIN_MIN_LENGTH=6
COOKIE_SECURE=auto

# Konfigurasi Storage & Batas Upload (Direkomendasikan di luar webroot pada production)
# PT_STORAGE_DIR=C:/laragon/storage/project_tracker
# PT_FILES_DIR=C:/laragon/storage/project_tracker/files
# PT_BACKUP_DIR=C:/laragon/storage/project_tracker/backup
PT_MAX_UPLOAD_MB=100
