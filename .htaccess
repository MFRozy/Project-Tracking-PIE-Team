Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Blokir akses langsung ke file sensitif, konfigurasi, script database, dan dokumen sumber
<FilesMatch "(^#.*#|\.(bak|conf|dist|env|fla|in[ci]|json|log|md|orig|psd|sh|sql|sw[op]|txt|xls|xlsx|bat|lock)$|^(config|db)\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RewriteEngine On

# Blokir akses HTTP langsung ke direktori internal (storage, data, tests, legacy, .git)
RewriteRule ^(storage|data|tests|legacy|\.git)(/|$) - [F,L,NC]

# Izinkan file statis di public/ serta entry point index.php dan api.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(index\.php|api\.php|public/.+)$ - [L]

# Rute API dan antarmuka aplikasi (mendukung instalasi di root maupun subfolder /ProjectTracker)
RewriteRule ^(?:ProjectTracker/)?api/(.*)$ api.php?route=/api/$1 [L,QSA]
RewriteRule ^$ index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L,QSA]
